#!/bin/sh
# SPDX-FileCopyrightText: 2026 ThingEdu <tuan@rogo.com.vn>
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

RCC=/usr/share/gcompris-qt/rcc
TEP="core.rcc activities.rcc menu.rcc geography.rcc geo-country.rcc"

# Năm tệp này thuộc gói gcompris-qt-data nên không đóng bản đã vá vào .deb được.
# dpkg-divert đẩy bản gốc sang <tệp>.orig và để chỗ cũ cho bản vá của ta; mỗi
# lần gcompris-qt-data nâng đời, dpkg ghi bản gốc mới vào .orig và trigger gọi
# va_lai.sh vá lại từ đó.
dat_chuyen_huong() {
    for t in $TEP; do
        f="$RCC/$t"
        [ -e "$f" ] || [ -e "$f.orig" ] || continue
        [ -z "$(dpkg-divert --listpackage "$f")" ] || continue
        # Máy đã vá tay bằng deploy/install_vi.sh thì $f.orig mới là bản gốc còn
        # $f đã bị sửa. Trả bản gốc về chỗ cũ trước, không thì dpkg-divert
        # --rename sẽ cất bản ĐÃ VÁ đi làm bản gốc và mất bản gốc thật.
        [ -f "$f.orig" ] && mv -f "$f.orig" "$f"
        dpkg-divert --add --rename --divert "$f.orig" --package gcompris-vi "$f"
    done
}

case "$1" in
    configure)
        dat_chuyen_huong
        /usr/share/gcompris-vi/va_lai.sh
        ;;
    triggered)
        /usr/share/gcompris-vi/va_lai.sh
        ;;
esac

#DEBHELPER#
exit 0
