#. Activity title
#: activities/frieze/ActivityInfo.qml:14
msgctxt "ActivityInfo|"
msgid "Frieze"
msgstr "Dải hoa văn"

#. Help title
#: activities/frieze/ActivityInfo.qml:16
msgctxt "ActivityInfo|"
msgid "Reproduce and complete the frieze."
msgstr "Vẽ tiếp và hoàn thành dải hoa văn."

#. Help goal
#: activities/frieze/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid "Learn algorithms."
msgstr "Học về thuật toán."

#. Help manual
#: activities/frieze/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid ""
"Reproduce the frieze on top. On some levels, you may have to complete the "
"frieze or to reproduce it after you've memorized it."
msgstr ""
"Vẽ lại dải hoa văn ở phía trên. Ở một số cấp, con phải vẽ nốt dải hoa văn, "
"hoặc phải nhớ rồi mới vẽ lại."

#: activities/frieze/ActivityInfo.qml:24
msgctxt "ActivityInfo|"
msgid "Left and right arrows: select a token"
msgstr "Mũi tên trái và phải: chọn một mảnh"

#: activities/frieze/ActivityInfo.qml:25
msgctxt "ActivityInfo|"
msgid "Space: add selected token to the frieze"
msgstr "Phím cách: thêm mảnh đang chọn vào dải hoa văn"

#: activities/frieze/ActivityInfo.qml:26
msgctxt "ActivityInfo|"
msgid "Backspace or Delete: remove last token from the frieze"
msgstr "Phím xoá lùi hoặc Delete: bỏ mảnh cuối khỏi dải hoa văn"

#: activities/frieze/ActivityInfo.qml:27
msgctxt "ActivityInfo|"
msgid "Enter: validate the answer"
msgstr "Enter: xác nhận câu trả lời"

#: activities/frieze/ActivityInfo.qml:28
msgctxt "ActivityInfo|"
msgid "Tab: switch between editing the frieze and viewing the model"
msgstr "Tab: chuyển qua lại giữa vẽ dải hoa văn và xem hình mẫu"

#: activities/frieze/Frieze.qml:294
msgctxt "Frieze|"
