"thứ tự thời gian."

#: activities/ordering_chronology/resource/1/Data.qml:13
msgctxt "Data|"
msgid "Cycle of life of a flower."
msgstr "Vòng đời của một bông hoa."

#: activities/ordering_chronology/resource/2/Data.qml:13
msgctxt "Data|"
msgid "Travel to the Moon."
msgstr "Chuyến đi lên Mặt Trăng."

#: activities/ordering_chronology/resource/3/Data.qml:13
