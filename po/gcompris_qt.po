#. Help manual
#: activities/adjacent_numbers/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid "Find the requested numbers and drag them to the corresponding spot."
msgstr "Tìm các số được yêu cầu rồi kéo chúng về đúng chỗ."

#. One or more numbers to find, all at the beginning of the list. Don't
#. display the %n in the translation if possible (actual English strings are
#. "Find the previous number" and "Find the previous numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:60
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n previous number(s)."
msgid_plural "Find the %n previous number(s)."
msgstr[0] "Tìm %n số liền trước."

#. One or more numbers to find, at the end of the list. Don't display the %n
#. in the translation if possible (actual English strings are "Find the next
#. number" and "Find the next numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:64
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n next number(s)."
msgid_plural "Find the %n next number(s)."
msgstr[0] "Tìm %n số liền sau."

#. One or more numbers to find, not at the beginning nor at the end of the
#. list. Don't display the %n in the translation if possible (actual English
#. strings are "Find the in-between number" and "Find the in-between numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:68
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n in-between number(s)"
msgid_plural "Find the %n in-between number(s)"
msgstr[0] "Tìm %n số ở giữa"

#. More than one number to find, with at least one number at the beginning or
#. at the end of the list. Don't display the %n in the translation if possible
#. (actual English string is "Find the missing numbers")
#: activities/adjacent_numbers/Adjacent_numbers.qml:72
#, qt-format
msgctxt "Adjacent_numbers|"
msgid "Find the %n missing numbers"
msgid_plural "Find the %n missing numbers"
msgstr[0] "Tìm %n số còn thiếu"

