msgctxt "ActivityInfo|"
msgid "Create the fractions"
msgstr "Tạo phân số"

#. Help title
#: activities/fractions_create/ActivityInfo.qml:16
msgctxt "ActivityInfo|"
msgid ""
"Select the appropriate number of parts to represent the given fraction."
msgstr "Chọn đúng số phần để biểu diễn phân số đã cho."

#. Help goal
#: activities/fractions_create/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid "Learn to represent a given fraction of a shape."
msgstr "Học cách biểu diễn một phân số của hình cho trước."

#. Help manual
