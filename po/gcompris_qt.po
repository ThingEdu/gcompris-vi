msgctxt "ActivityInfo|"
msgid "Find the fractions"
msgstr "Tìm phân số"

#. Help title
#: activities/fractions_find/ActivityInfo.qml:16
msgctxt "ActivityInfo|"
msgid ""
"Find the correct numerator and denominator of the represented fraction."
msgstr "Tìm đúng tử số và mẫu số của phân số được vẽ."

#. Help goal
#: activities/fractions_find/ActivityInfo.qml:19
msgctxt "ActivityInfo|"
msgid ""
"Learn to write a fraction corresponding to a given fractional "
"representation."
msgstr "Học cách viết phân số ứng với hình biểu diễn cho trước."

#. Help manual
#: activities/fractions_find/ActivityInfo.qml:22
msgctxt "ActivityInfo|"
msgid ""
"Write the fraction corresponding to the fractional representation: Count the"
" total number of parts of the represented shape, and set it as the "
"denominator. Then count the number of selected parts, and set it as the "
"numerator."
msgstr ""
"Viết phân số ứng với hình đã vẽ: đếm tổng số phần của hình rồi lấy làm mẫu "
"số. Sau đó đếm số phần đã được chọn rồi lấy làm tử số."

#: activities/fractions_find/resource/1/Data.qml:19
msgctxt "Data|"
msgid "Find numerator (with a pie)."
msgstr "Tìm tử số (với hình cái bánh)."

