msgid ""
msgstr ""
"Project-Id-Version: gcompris_qt (đời cũ)\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Qt-Contexts: true\n"

msgctxt "ActivityInfo|"
msgid "A baby word processor"
msgstr "Trang soạn thảo đầu tiên của bé"

msgctxt "ActivityInfo|"
msgid ""
"A decimal number is displayed. Drag the arrow to select a part of the bar, "
"and drag the selected part of the bar to the empty area. Repeat these steps "
"until the number of dropped bars corresponds to the displayed decimal "
"number. Then click on the OK button to validate your answer."
msgstr ""
"Màn hình hiện một số thập phân. Kéo mũi tên để chọn một phần của thanh, rồi "
"kéo phần đã chọn sang vùng trống. Làm đi làm lại tới khi số thanh đã thả "
"đúng bằng số thập phân đang hiện. Sau đó bấm nút Đồng ý để kiểm tra câu trả "
"lời."

msgctxt "ActivityInfo|"
msgid ""
"A digit is displayed on the screen. Fill the corresponding number of circles"
" and validate your answer."
msgstr ""
"Màn hình hiện một chữ số. Hãy tô đúng số vòng tròn tương ứng rồi kiểm tra "
"câu trả lời."

msgctxt "ActivityInfo|"
msgid ""
"A family tree is shown, with some instructions.\n"
"The circles are linked with lines to mark the relations. Married couples are marked with a ring on the link.\n"
"Click on a pair of family members which corresponds to the given relation."
msgstr ""
"Màn hình hiện một cây gia đình kèm yêu cầu.\n"
"Các vòng tròn nối với nhau bằng đường kẻ để chỉ quan hệ họ hàng. Vợ chồng thì đường nối có thêm một chiếc nhẫn.\n"
"Bấm vào một cặp người thân đúng với quan hệ được nêu."

msgctxt "ActivityInfo|"
msgid ""
"A letter is written. Some words are displayed, and you must find the word or"
" the words in which this letter appears."
msgstr ""
"Một chữ cái được viết ra. Có vài từ hiện lên, con phải tìm từ nào có chứa "
"chữ cái đó."

msgctxt "ActivityInfo|"
msgid "A shape split in equal parts is displayed on screen."
msgstr "Màn hình hiện một hình đã chia thành các phần bằng nhau."

msgctxt "ActivityInfo|"
msgid "A simple drawing activity"
msgstr "Hoạt động vẽ đơn giản"

msgctxt "ActivityInfo|"
msgid ""
"A simplistic word processor to let the children play around with a keyboard "
"and see letters."
msgstr ""
"Một trang soạn thảo thật đơn giản để trẻ nghịch bàn phím và nhìn thấy chữ "
"hiện ra."

msgctxt "ActivityInfo|"
msgid "Additions and subtractions."
msgstr "Phép cộng và phép trừ."

msgctxt "ActivityInfo|"
msgid "Additions with decimal numbers"
msgstr "Cộng số thập phân"

msgctxt "ActivityInfo|"
msgid "Additions, subtractions, multiplications, divisions."
msgstr "Cộng, trừ, nhân, chia."

msgctxt "ActivityInfo|"
msgid "Additions."
msgstr "Phép cộng."

msgctxt "ActivityInfo|"
msgid "Alphabet sequence."
msgstr "Thứ tự bảng chữ cái."

msgctxt "ActivityInfo|"
msgid ""
"An addition with two decimal numbers is displayed. Drag the arrow to select "
"a part of the bar, and drag the selected part of the bar to the empty area. "
"Repeat these steps until the number of dropped bars corresponds to the "
"result of the addition, and click on the OK button to validate your answer."
msgstr ""
"Màn hình hiện một phép cộng hai số thập phân. Kéo mũi tên để chọn một phần "
"của thanh, rồi kéo phần đã chọn sang vùng trống. Làm đi làm lại tới khi số "
"thanh đã thả đúng bằng kết quả phép cộng, rồi bấm nút Đồng ý để kiểm tra câu"
" trả lời."

msgctxt "ActivityInfo|"
msgid "Answer the questions with a correctness of 100%."
msgstr "Trả lời các câu hỏi sao cho đúng 100%."

msgctxt "ActivityInfo|"
msgid "Arrange four tokens in a row."
msgstr "Xếp bốn quân thành một hàng."

msgctxt "ActivityInfo|"
msgid "Arrange the pieces in the right order."
msgstr "Sắp các mảnh theo đúng thứ tự."

msgctxt "ActivityInfo|"
msgid "Baby keyboard"
msgstr "Bàn phím đầu tiên của bé"

msgctxt "ActivityInfo|"
msgid "Baby mouse"
msgstr "Chuột máy tính đầu tiên của bé"

msgctxt "ActivityInfo|"
msgid "Baby puzzle"
msgstr "Xếp hình đơn giản"

msgctxt "ActivityInfo|"
msgid "Can decide chronological order of events."
msgstr "Sắp được các sự kiện theo thứ tự thời gian."

msgctxt "ActivityInfo|"
msgid "Can move mouse and click on the correct place."
msgstr "Di được chuột và bấm đúng chỗ."

msgctxt "ActivityInfo|"
msgid ""
"Capture all the pieces of your opponent before your opponent captures all of"
" yours."
msgstr "Bắt hết quân của đối thủ trước khi đối thủ bắt hết quân của con."

msgctxt "ActivityInfo|"
msgid ""
"Catch the clouds with an odd or even number, in the right order. With a "
"keyboard, use the arrow keys to move the helicopter. With a pointing device,"
" just click or tap on the target location. To know which number you have to "
"catch you can either remember it or check the number on the bottom right "
"corner."
msgstr ""
"Bắt các đám mây mang số chẵn hoặc số lẻ theo đúng thứ tự. Nếu có bàn phím "
"thì dùng phím mũi tên để lái trực thăng. Nếu dùng chuột hay màn hình cảm ứng"
" thì chỉ cần bấm hoặc chạm vào chỗ cần tới. Muốn biết phải bắt số nào thì "
"con nhớ trong đầu, hoặc nhìn con số ở góc dưới bên phải."

msgctxt "ActivityInfo|"
msgid ""
"Change the color by moving the sliders on the torches or by clicking on the "
"+ and - buttons. Then click on the OK button to validate your answer."
msgstr ""
"Đổi màu bằng cách kéo thanh trượt trên các đèn pin, hoặc bấm nút + và -. Rồi"
" bấm nút Đồng ý để kiểm tra câu trả lời."

msgctxt "ActivityInfo|"
msgid ""
"Change the color by moving the sliders on the tubes of paint or by clicking "
"on the + and - buttons. Then click on the OK button to validate your answer."
msgstr ""
"Đổi màu bằng cách kéo thanh trượt trên các tuýp màu, hoặc bấm nút + và -. "
"Rồi bấm nút Đồng ý để kiểm tra câu trả lời."

msgctxt "ActivityInfo|"
msgid "Click on a pair corresponding to the given relation."
msgstr "Bấm vào một cặp đúng với quan hệ được nêu."

msgctxt "ActivityInfo|"
msgid "Click on the grid squares to move Tux following the given directions."
msgstr "Bấm vào các ô trên lưới để đưa Tux đi theo đúng các hướng đã cho."

msgctxt "ActivityInfo|"
msgid "Click or tap to erase the area and discover the background."
msgstr "Bấm hoặc chạm để xoá lớp phủ và thấy bức tranh bên dưới."

msgctxt "ActivityInfo|"
msgid "Compare numbers."
msgstr "So sánh số."

msgctxt "ActivityInfo|"
msgid "Complete the arrangement of fruit."
msgstr "Xếp nốt dãy hoa quả."

msgctxt "ActivityInfo|"
msgid ""
"Complete the puzzle by dragging each piece on the side to the matching space"
" in the puzzle."
msgstr ""
"Hoàn thành bức tranh bằng cách kéo từng mảnh bên cạnh về đúng chỗ trống của "
"nó."

msgctxt "ActivityInfo|"
msgid "Count a number in a limited time."
msgstr "Đếm một số trong thời gian có hạn."

msgctxt "ActivityInfo|"
msgid "Count and color the circles"
msgstr "Đếm rồi tô các vòng tròn"

msgctxt "ActivityInfo|"
msgid "Count the number on the domino before it reaches the ground."
msgstr "Đếm số chấm trên quân đô-mi-nô trước khi nó chạm đất."

msgctxt "ActivityInfo|"
msgid "Create a digital electric schema with a real time simulation of it."
msgstr "Vẽ một mạch điện số và mô phỏng ngay tức thì."

msgctxt "ActivityInfo|"
msgid ""
"Create a line of 4 tokens either horizontally (lying down), vertically "
"(standing up) or diagonally."
msgstr "Xếp 4 quân thành một hàng ngang, hàng dọc hoặc đường chéo."

msgctxt "ActivityInfo|"
msgid "Create and simulate a digital electric schema."
msgstr "Vẽ và mô phỏng một mạch điện số."

msgctxt "ActivityInfo|"
msgid "Discover the keyboard and the letters."
msgstr "Làm quen với bàn phím và các chữ cái."

msgctxt "ActivityInfo|"
msgid "Divisions"
msgstr "Phép chia"

msgctxt "ActivityInfo|"
msgid "Divisions."
msgstr "Phép chia."

msgctxt "ActivityInfo|"
msgid "Don't put the ball in the last hole."
msgstr "Đừng để mình phải thả bi vào lỗ cuối cùng."

msgctxt "ActivityInfo|"
msgid ""
"Double tap or double click to erase the area and discover the background "
"image."
msgstr "Chạm đúp hoặc bấm đúp để xoá lớp phủ và thấy bức tranh bên dưới."

msgctxt "ActivityInfo|"
msgid ""
"Drag a line from the ball to set its speed and direction, and release it to "
"kick the ball."
msgstr ""
"Kéo một đường từ quả bóng để chỉnh lực và hướng, rồi buông ra để sút bóng."

msgctxt "ActivityInfo|"
msgid ""
"Drag and Drop one top piece at a time, from one tower to another, to "
"reproduce the tower on the right in the empty area."
msgstr ""
"Mỗi lần kéo thả một mảnh trên cùng từ tháp này sang tháp kia, để dựng lại ở "
"chỗ trống cái tháp bên phải."

msgctxt "ActivityInfo|"
msgid "Drag and Drop the items to complete the map."
msgstr "Kéo thả các mảnh để hoàn thành bản đồ."

msgctxt "ActivityInfo|"
msgid "Drag and Drop the regions to complete the country maps."
msgstr "Kéo thả các vùng để hoàn thành bản đồ quốc gia."

msgctxt "ActivityInfo|"
msgid ""
"Drag and drop different regions of the country to their correct locations to"
" complete the map."
msgstr "Kéo thả các vùng của quốc gia về đúng chỗ để hoàn thành bản đồ."

msgctxt "ActivityInfo|"
msgid ""
"Drag and drop the map pieces to their correct locations to complete the map."
msgstr "Kéo thả các mảnh bản đồ về đúng chỗ để hoàn thành bản đồ."

msgctxt "ActivityInfo|"
msgid ""
"Drag and drop the top pieces only from one peg to another, to reproduce the "
"initial left side tower on the right peg."
msgstr ""
"Mỗi lần chỉ kéo thả mảnh trên cùng từ cọc này sang cọc kia, để dựng lại cái "
"tháp bên trái sang cọc bên phải."

msgctxt "ActivityInfo|"
msgid ""
"Drag the appropriate numbers and the operators to the boxes to obtain the "
"number to guess in the instruction."
msgstr ""
"Kéo các con số và dấu phép tính thích hợp vào các ô để ra được số ghi trong "
"đề bài."

msgctxt "ActivityInfo|"
msgid "Draw the image on the empty grid as if you saw it in a mirror."
msgstr "Vẽ lại bức hình lên lưới ô trống như khi nhìn nó trong gương."

msgctxt "ActivityInfo|"
msgid "Draw the letters by connecting the dots in the correct order."
msgstr "Viết các chữ cái bằng cách nối các chấm theo đúng thứ tự."

msgctxt "ActivityInfo|"
msgid "Draw the numbers by connecting the dots in the correct order."
msgstr "Viết các chữ số bằng cách nối các chấm theo đúng thứ tự."

msgctxt "ActivityInfo|"
msgid "Draw the picture by clicking on each number in the right order."
msgstr "Vẽ bức tranh bằng cách bấm vào từng con số theo đúng thứ tự."

msgctxt "ActivityInfo|"
msgid ""
"Draw the picture by clicking on each point in sequence. Each time a point is"
" selected the next blue one appears."
msgstr ""
"Vẽ bức tranh bằng cách bấm lần lượt vào từng điểm. Mỗi lần chọn một điểm thì"
" điểm xanh tiếp theo hiện ra."

msgctxt "ActivityInfo|"
msgid "Enhance creative skills."
msgstr "Rèn óc sáng tạo."

msgctxt "ActivityInfo|"
msgid "Enter: validate your answer when the OK button is visible"
msgstr "Enter: xác nhận câu trả lời khi nút Đồng ý hiện ra"

msgctxt "ActivityInfo|"
msgid ""
"Form mills (lines of 3 pieces) to remove Tux's pieces until he has only 2 "
"pieces left or can not move anymore."
msgstr ""
"Xếp ba quân thành hàng để ăn quân của Tux, cho tới khi Tux chỉ còn 2 quân "
"hoặc không đi được nữa."

msgctxt "ActivityInfo|"
msgid ""
"Form mills (lines of 3 pieces) to remove your opponent's pieces until your "
"opponent has only 2 pieces left or can not move anymore."
msgstr ""
"Xếp ba quân thành hàng để ăn quân của đối thủ, cho tới khi đối thủ chỉ còn 2"
" quân hoặc không đi được nữa."

msgctxt "ActivityInfo|"
msgid ""
"From Wikipedia, the free encyclopedia. Tangram (Chinese: literally 'seven boards of cunning') is a Chinese puzzle. While the tangram is often said to be ancient, its existence has only been verified as far back as 1800. It consists of 7 pieces, called tans, which fit together to form a square; Using the square side as 1 unit, the 7 pieces contains:\n"
"    5 right isosceles triangles, including:\n"
"        - 2 small size ones (legs of 1)\n"
"        - 1 medium size (legs of square root of 2)\n"
"        - 2 large size (legs of 2)\n"
"    1 square (side of 1) and\n"
"    1 parallelogram (sides of 1 and square root of 2)\n"
"    "
msgstr ""
"Theo Wikipedia, bách khoa toàn thư mở. Tangram (tiếng Trung: nghĩa đen là 'bảy tấm ván khôn khéo') là một câu đố của Trung Quốc. Người ta hay nói Tangram có từ rất xưa, nhưng chỉ xác minh được là nó có từ khoảng năm 1800. Bộ này gồm 7 mảnh, gọi là tan, ghép lại thành một hình vuông; lấy cạnh hình vuông làm 1 đơn vị thì 7 mảnh gồm:\n"
"    5 tam giác vuông cân, trong đó:\n"
"        - 2 mảnh nhỏ (cạnh góc vuông bằng 1)\n"
"        - 1 mảnh vừa (cạnh góc vuông bằng căn bậc hai của 2)\n"
"        - 2 mảnh lớn (cạnh góc vuông bằng 2)\n"
"    1 hình vuông (cạnh bằng 1) và\n"
"    1 hình bình hành (cạnh bằng 1 và căn bậc hai của 2)\n"
"    "

msgctxt "ActivityInfo|"
msgid ""
"Guess the algebraic expression and drag the tiles to get a result equal to "
"the Guesscount."
msgstr "Đoán ra biểu thức rồi kéo các ô để có kết quả đúng bằng số cần đoán."

msgctxt "ActivityInfo|"
msgid "Hit the target and count your points."
msgstr "Ném trúng bia rồi tính điểm của con."

msgctxt "ActivityInfo|"
msgid "Identify the notes correctly and score 100% to complete a level."
msgstr "Nhận ra đúng các nốt và đạt 100% để qua màn."

msgctxt "ActivityInfo|"
msgid "In a limited time, count the number of dots."
msgstr "Đếm số chấm trong thời gian có hạn."

msgctxt "ActivityInfo|"
msgid "Intuition and practice of algebraic-like calculations."
msgstr "Cảm nhận và luyện tập kiểu tính toán đại số."

msgctxt "ActivityInfo|"
msgid "Keyboard training."
msgstr "Luyện gõ bàn phím."

msgctxt "ActivityInfo|"
msgid "Kick the ball behind the goal keeper on the right."
msgstr "Sút bóng qua người thủ môn bên phải."

msgctxt "ActivityInfo|"
msgid "Learn additions"
msgstr "Học phép cộng"

msgctxt "ActivityInfo|"
msgid "Learn additions by counting their result."
msgstr "Học phép cộng bằng cách đếm kết quả."

msgctxt "ActivityInfo|"
msgid ""
"Learn additions with decimal numbers by counting how many squares are needed"
" to represent the result."
msgstr ""
"Học phép cộng số thập phân bằng cách đếm xem cần bao nhiêu ô vuông để biểu "
"diễn kết quả."

msgctxt "ActivityInfo|"
msgid "Learn additions with decimal numbers."
msgstr "Học phép cộng với số thập phân."

msgctxt "ActivityInfo|"
msgid "Learn additions with small numbers."
msgstr "Học phép cộng với các số nhỏ."

msgctxt "ActivityInfo|"
msgid "Learn additions."
msgstr "Học phép cộng."

msgctxt "ActivityInfo|"
msgid ""
"Learn decimals by counting how many squares are needed to represent the "
"decimal number."
msgstr ""
"Học số thập phân bằng cách đếm xem cần bao nhiêu ô vuông để biểu diễn số đó."

msgctxt "ActivityInfo|"
msgid "Learn decimals with small numbers."
msgstr "Học số thập phân với các số nhỏ."

msgctxt "ActivityInfo|"
msgid "Learn digits by counting their corresponding value."
msgstr "Học chữ số bằng cách đếm giá trị tương ứng."

msgctxt "ActivityInfo|"
msgid "Learn digits from 0 to 9."
msgstr "Học chữ số từ 0 tới 9."

msgctxt "ActivityInfo|"
msgid "Learn division of numbers."
msgstr "Học phép chia."

msgctxt "ActivityInfo|"
msgid "Learn how to communicate with the International Morse code."
msgstr "Học cách trao đổi bằng mã Morse quốc tế."

msgctxt "ActivityInfo|"
msgid ""
"Learn how to read roman numerals and do the conversion to and from arabic "
"numerals."
msgstr "Học cách đọc chữ số La Mã và đổi qua lại với chữ số Ả Rập."

msgctxt "ActivityInfo|"
msgid "Learn subtractions"
msgstr "Học phép trừ"

msgctxt "ActivityInfo|"
msgid "Learn subtractions by counting their result."
msgstr "Học phép trừ bằng cách đếm kết quả."

msgctxt "ActivityInfo|"
msgid ""
"Learn subtractions with decimal numbers by counting how many squares need to"
" be subtracted to represent the result."
msgstr ""
"Học phép trừ số thập phân bằng cách đếm xem cần bớt bao nhiêu ô vuông để "
"biểu diễn kết quả."

msgctxt "ActivityInfo|"
msgid "Learn subtractions with decimal numbers."
msgstr "Học phép trừ với số thập phân."

msgctxt "ActivityInfo|"
msgid "Learn subtractions with small numbers."
msgstr "Học phép trừ với các số nhỏ."

msgctxt "ActivityInfo|"
msgid "Learn subtractions."
msgstr "Học phép trừ."

msgctxt "ActivityInfo|"
msgid ""
"Learn the rules to read Roman numerals and practice converting numbers to "
"and from arabic numerals. Click on the OK button to validate your answer."
msgstr ""
"Học luật đọc chữ số La Mã rồi luyện đổi qua lại với chữ số Ả Rập. Bấm nút "
"Đồng ý để kiểm tra câu trả lời."

msgctxt "ActivityInfo|"
msgid "Learn the water cycle."
msgstr "Tìm hiểu vòng tuần hoàn của nước."

msgctxt "ActivityInfo|"
msgid ""
"Learn to distinguish between different colors/shapes and learn about "
"relative positions."
msgstr "Học cách phân biệt màu sắc, hình dạng và hiểu về vị trí tương đối."

msgctxt "ActivityInfo|"
msgid "Learning how to draw letters in a funny way."
msgstr "Học cách viết chữ cái một cách vui vẻ."

msgctxt "ActivityInfo|"
msgid "Learning how to draw numbers in a funny way."
msgstr "Học cách viết chữ số một cách vui vẻ."

msgctxt "ActivityInfo|"
msgid "Learning lowercase and uppercase letters, memory."
msgstr "Học chữ thường và chữ hoa, rèn trí nhớ."

msgctxt "ActivityInfo|"
msgid "Letter association between the screen and the keyboard."
msgstr "Gắn chữ cái trên màn hình với chữ cái trên bàn phím."

msgctxt "ActivityInfo|"
msgid "Letter-name recognition."
msgstr "Nhận ra tên của chữ cái."

msgctxt "ActivityInfo|"
msgid "Logic training activity."
msgstr "Hoạt động rèn tư duy logic."

msgctxt "ActivityInfo|"
msgid "Mix primary colors to match the given color."
msgstr "Pha các màu cơ bản cho ra đúng màu yêu cầu."

msgctxt "ActivityInfo|"
msgid ""
"Mixing light colors is just the opposite of mixing paint colors. The more "
"light you add, the lighter the resulting color becomes. Primary colors of "
"light are red, green and blue."
msgstr ""
"Pha màu ánh sáng thì ngược hẳn với pha màu sơn. Càng thêm ánh sáng thì màu "
"càng sáng lên. Ba màu cơ bản của ánh sáng là đỏ, xanh lá và xanh lam."

msgctxt "ActivityInfo|"
msgid ""
"Moon photo is copyright NASA. The space sounds come from Tuxpaint and "
"Vegastrike which are released under the GPL license. The transportation "
"images are copyright Franck Doucet. Dates of Transportation are based on "
"those found in &lt;https://www.wikipedia.org&gt;."
msgstr ""
"Ảnh Mặt Trăng thuộc bản quyền NASA. Âm thanh vũ trụ lấy từ Tuxpaint và "
"Vegastrike, phát hành theo giấy phép GPL. Ảnh phương tiện đi lại thuộc bản "
"quyền Franck Doucet. Mốc thời gian của các phương tiện dựa theo "
"&lt;https://www.wikipedia.org&gt;."

msgctxt "ActivityInfo|"
msgid "Motor coordination: moving the hand precisely."
msgstr "Phối hợp vận động: di chuyển bàn tay thật chính xác."

msgctxt "ActivityInfo|"
msgid "Motor-coordination."
msgstr "Phối hợp vận động."

msgctxt "ActivityInfo|"
msgid ""
"Move a piece by dragging it. The symmetrical button appears on items that "
"supports it. Click on the rotation button or drag around it to rotate "
"selected piece. Check the activity 'Baby Puzzle' for a simpler introduction "
"to tangram."
msgstr ""
"Kéo để di chuyển một mảnh ghép. Nút đối xứng hiện ra ở những mảnh dùng được "
"nó. Bấm nút xoay hoặc kéo quanh nó để xoay mảnh đang chọn. Muốn làm quen với"
" Tangram một cách dễ hơn thì vào hoạt động 'Xếp hình đơn giản'."

msgctxt "ActivityInfo|"
msgid ""
"Move the mouse or touch the screen to erase the area and discover the "
"background."
msgstr ""
"Di chuột hoặc chạm màn hình để xoá lớp phủ và thấy bức tranh bên dưới."

msgctxt "ActivityInfo|"
msgid "Move the tower to the right side."
msgstr "Chuyển cả tháp sang bên phải."

msgctxt "ActivityInfo|"
msgid "Multiplications, divisions."
msgstr "Phép nhân, phép chia."

msgctxt "ActivityInfo|"
msgid "Multiplications."
msgstr "Phép nhân."

msgctxt "ActivityInfo|"
msgid "Numbers from 1 to 10 and additions."
msgstr "Các số từ 1 tới 10 và phép cộng."

msgctxt "ActivityInfo|"
